local function getPlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)
    return names
end

local function refreshFriendDropdownList(playerNames)
    for _, child in ipairs(friendDropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, name in ipairs(playerNames) do
        local btn = Instance.new("TextButton", friendDropdownList)
        btn.Size = UDim2.new(1, -10, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        btn.TextSize = 12
        btn.Font = Enum.Font.Gotham
        btn.BorderSizePixel = 0
        local btnCornerLocal = Instance.new("UICorner", btn)
        btnCornerLocal.CornerRadius = UDim.new(0, 4)
        btn.MouseButton1Click:Connect(function()
            local idx = tableFind(friends, name)
            if idx then
                table.remove(friends, idx)
                local autoIdx = tableFind(tmkAutoAdded, name)
                if autoIdx then table.remove(tmkAutoAdded, autoIdx) end
            else
                table.insert(friends, name)
            end
            updateFriendDisplay()
            friendDropdownList.Visible = false
        end)
    end
    friendDropdownList.CanvasSize = UDim2.new(0, 0, 0, #playerNames * 30)
end

local function refreshTargetDropdownList(playerNames)
    for _, child in ipairs(targetDropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, name in ipairs(playerNames) do
        local btn = Instance.new("TextButton", targetDropdownList)
        btn.Size = UDim2.new(1, -10, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        btn.TextSize = 12
        btn.Font = Enum.Font.Gotham
        btn.BorderSizePixel = 0
        local btnCornerLocal = Instance.new("UICorner", btn)
        btnCornerLocal.CornerRadius = UDim.new(0, 4)
        btn.MouseButton1Click:Connect(function()
            local idx = tableFind(targets, name)
            if idx then
                table.remove(targets, idx)
            else
                table.insert(targets, name)
            end
            updateTargetDisplay()
            targetDropdownList.Visible = false
        end)
    end
    targetDropdownList.CanvasSize = UDim2.new(0, 0, 0, #playerNames * 30)
end

