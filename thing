-- Dragging with bounds
local dragging = false
local dragStart = nil
local frameStart = nil

local function getScreenSize()
    local screen = screenGui.AbsoluteSize
    if screen.X == 0 then
        screen = workspace.CurrentCamera.ViewportSize
    end
    return screen
end

local function clampFramePosition(offsetX, offsetY)
    local screenSize = getScreenSize()
    local frameSize = mainFrame.AbsoluteSize
    local minX = 0
    local maxX = screenSize.X - frameSize.X
    local minY = 0
    local maxY = screenSize.Y - frameSize.Y
    return math.clamp(offsetX, minX, maxX), math.clamp(offsetY, minY, maxY)
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        frameStart = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newX = frameStart.X.Offset + delta.X
        local newY = frameStart.Y.Offset + delta.Y
        local clampedX, clampedY = clampFramePosition(newX, newY)
        mainFrame.Position = UDim2.new(0, clampedX, 0, clampedY)
    end
end)

-- Minimize / restore
local minimized = false
local originalSize = mainFrame.Size

minimizeBtn.MouseButton1Click:Connect(function()
