local autoWhitelistTMK = false
local tmkAutoAdded = {}

-- Helper functions
local function tableFind(t, val)
    for i, v in ipairs(t) do
        if v == val then return i end
    end
    return nil
end

local function normalize(name)
    return name:lower():gsub("%s+", "")
end

local function containsTMK(name)
    return name:lower():find("tmk") ~= nil
end

local function isInList(player, list)
    local pName = normalize(player.Name)
    local pDisplay = normalize(player.DisplayName)
    for _, entry in ipairs(list) do
        local eNorm = normalize(entry)
        if pName == eNorm or pDisplay == eNorm then
            return true
        end
    end
    return false
end

-- Auto-whitelist TMK
local function refreshAutoWhitelist()
    if not autoWhitelistTMK then
        for _, name in ipairs(tmkAutoAdded) do
            local idx = tableFind(friends, name)
            if idx then table.remove(friends, idx) end
        end
        tmkAutoAdded = {}
        updateFriendDisplay()
        return
    end

    local function addIfTMK(plr)
        if containsTMK(plr.Name) or containsTMK(plr.DisplayName) then
            local nameToStore = plr.Name
            if not tableFind(friends, nameToStore) then
                table.insert(friends, nameToStore)
                table.insert(tmkAutoAdded, nameToStore)
            end
        end
    end

    for _, name in ipairs(tmkAutoAdded) do
        local idx = tableFind(friends, name)
        if idx then table.remove(friends, idx) end
    end
    tmkAutoAdded = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            addIfTMK(plr)
        end
    end
    updateFriendDisplay()
end

local function setupPlayerAddedListener()
    local conn
    conn = Players.PlayerAdded:Connect(function(plr)
        if autoWhitelistTMK and (containsTMK(plr.Name) or containsTMK(plr.DisplayName)) then
            if not tableFind(friends, plr.Name) then
                table.insert(friends, plr.Name)
                table.insert(tmkAutoAdded, plr.Name)
                updateFriendDisplay()
            end
        end
    end)
    return conn
end

local playerAddedConn = nil
local function setAutoWhitelist(enabled)
    autoWhitelistTMK = enabled
    if playerAddedConn then playerAddedConn:Disconnect() end
    if enabled then
        playerAddedConn = setupPlayerAddedListener()
    end
    refreshAutoWhitelist()
end

-- Get nearest target (respects friends + targets)
local function getNearestTarget()
    local char = localPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearest = nil
    local shortest = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            if isInList(plr, friends) then continue end
            if #targets > 0 and not isInList(plr, targets) then continue end
            local tChar = plr.Character
            if tChar then
                local root = tChar:FindFirstChild("HumanoidRootPart")
                local hum = tChar:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = plr
                    end
                end
            end
        end
    end
    return nearest
end

-- ULTRA FAST ATTACK: called every frame
local function attack()
    if not killAuraActive then return end
    local target = getNearestTarget()
    if target and target.Character then
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            for _ = 1, hitMultiplier do
                pcall(function()
                    CombatRF:InvokeServer(hum)
                end)
            end
        end
    end
end

-- Kill aura connected to RenderStepped (every frame, ~60+ times/sec)
local attackConnection = nil
local function setKillAura(active)
    killAuraActive = active
    if attackConnection then
        attackConnection:Disconnect()
        attackConnection = nil
    end
    if active then
        attackConnection = RunService.RenderStepped:Connect(attack)
    end
end

