--[[
    Single-Target Spam Hit - ULTRA FAST
    - Attacks every frame (RenderStepped)
    - Partial name matching (username or display name)
    - Multiplier spams remote multiple times per frame
    - Draggable, compact GUI
]]

-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- Remote
local CombatRF = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("CombatService"):WaitForChild("RF"):WaitForChild("Hit")

local localPlayer = Players.LocalPlayer

-- State
local spamActive = false
local hitMultiplier = 1
local targetPlayer = nil
local targetNameInput = ""

-- Helper: normalize for comparison
local function normalize(str)
    return str:lower():gsub("%s+", "")
end

-- Update target based on text input (partial match)
local function updateTarget()
    if targetNameInput == "" then
        targetPlayer = nil
        if targetLabel then targetLabel.Text = "Selected: None" end
        return
    end

    local inputNorm = normalize(targetNameInput)
    local bestMatch = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            local nameNorm = normalize(plr.Name)
            local displayNorm = normalize(plr.DisplayName)
            if nameNorm:find(inputNorm, 1, true) or displayNorm:find(inputNorm, 1, true) then
                bestMatch = plr
                break
            end
        end
    end

    targetPlayer = bestMatch
    if targetLabel then
        if bestMatch then
            targetLabel.Text = "Selected: " .. bestMatch.Name .. " (" .. bestMatch.DisplayName .. ")"
        else
            targetLabel.Text = "Selected: None (no match)"
        end
    end
end

-- Attack function (called every frame)
local function attack()
    if not spamActive then return end
    if not targetPlayer then return end

    local char = targetPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    for _ = 1, hitMultiplier do
        pcall(function()
            CombatRF:InvokeServer(hum)
        end)
    end
end

-- RenderStepped connection
local attackConnection = nil
local function setSpamActive(active)
    spamActive = active
    if attackConnection then
        attackConnection:Disconnect()
        attackConnection = nil
    end
    if active then
        attackConnection = RunService.RenderStepped:Connect(attack)
    end
end

