    setSpamActive(newState)
    toggleBtn.Text = newState and "Spam Hit: ON" or "Spam Hit: OFF"
    toggleBtn.BackgroundColor3 = newState and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(60, 60, 70)
end)

