-- Dragging logic
local dragging = false
local dragStart = nil
local frameStart = nil

local function clampFrame(pos)
    local screenSize = screenGui.AbsoluteSize
    if screenSize.X == 0 then screenSize = workspace.CurrentCamera.ViewportSize end
    local frameSize = mainFrame.AbsoluteSize
    local x = math.clamp(pos.X.Offset, 0, screenSize.X - frameSize.X)
    local y = math.clamp(pos.Y.Offset, 0, screenSize.Y - frameSize.Y)
    return UDim2.new(0, x, 0, y)
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        frameStart = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newPos = UDim2.new(0, frameStart.X.Offset + delta.X, 0, frameStart.Y.Offset + delta.Y)
        mainFrame.Position = clampFrame(newPos)
    end
end)

-- Minimize / restore
local minimized = false
local originalSize = mainFrame.Size
minimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset, 0, 28)
        }):Play()
        content.Visible = false
        minimizeBtn.Text = "+"
    else
        TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalSize
        }):Play()
        content.Visible = true
        minimizeBtn.Text = "−"
    end
end)

